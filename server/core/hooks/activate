#!/bin/bash
# بعد از جابه‌جایی نسخه (و در برگشت خودکار برای نسخه‌ی قبلی): سرویس‌ها، سایت و nginx. تکرارپذیر.
set -euo pipefail
R="$JARYAN_RELEASE"
if [ "${JARYAN_ROLLBACK:-0}" = 1 ]; then
  # پایگاه داده از پشتیبان برگشته؛ لایه‌ی سازگاری و رمزها دوباره هماهنگ شوند
  python3 "$R/services/migrate.py" apply "$R"
fi
chmod 711 /etc/jaryan          # سرویس‌های غیر root فقط فایل‌های 640 گروه jaryan را بخوانند؛ بقیه 600 هستند
[ -f /etc/jaryan/server.json ] || python3 "$R/services/serverconf.py" init
install -d -m 750 -o jaryan -g jaryan /var/lib/jaryan/files /var/lib/jaryan/jobs /var/lib/jaryan/deno
install -d -m 755 /var/lib/jaryan/acme-www
usermod -aG jaryan www-data    # nginx فایل‌های عمومی را مستقیم از دیسک بدهد
chmod 750 /var/lib/jaryan

echo "== سایت"
ANON=$(python3 -c "import json;print(json.load(open('/etc/jaryan/secrets.json'))['anon_key'])")
if [ -d "$R/site/design/assets" ]; then
  { grep -rl "__JARYAN_ANON_KEY__" "$R/site/design/assets" || true; } | xargs -r sed -i "s/__JARYAN_ANON_KEY__/$ANON/g"
fi

echo "== پایگاه داده (تنظیم حافظه)"
PGCONF=$(runuser -u postgres -- psql -tAc "show config_file" 2>/dev/null || true)
set +e
python3 "$R/services/pgtune.py" apply
TUNE=$?
set -e
if [ "$TUNE" = 10 ]; then
  systemctl restart postgresql || true
  UP=0
  for _ in $(seq 1 60); do
    if runuser -u postgres -- psql -tAc "select 1" >/dev/null 2>&1; then UP=1; break; fi
    sleep 1
  done
  if [ "$UP" = 0 ]; then
    # با تنظیم تازه بالا نیامد: همان را برمی‌داریم تا پایگاه داده با تنظیم قبلی کار کند
    echo "پایگاه داده با تنظیم حافظه‌ی تازه بالا نیامد؛ تنظیم برداشته شد"
    [ -n "$PGCONF" ] && rm -f "$(dirname "$PGCONF")/conf.d/90-jaryan.conf"
    systemctl restart postgresql
    for _ in $(seq 1 60); do runuser -u postgres -- psql -tAc "select 1" >/dev/null 2>&1 && break; sleep 1; done
  fi
fi

echo "== nginx"
python3 "$R/services/serverconf.py" nginx "$R"
install -m 644 "$R"/systemd/*.service "$R"/systemd/*.timer /etc/systemd/system/
systemctl daemon-reload
SVCS="jaryan-api jaryan-net jaryan-setup jaryan-storage jaryan-functions jaryan-jobs"
for s in $SVCS; do systemctl enable "$s.service" >/dev/null 2>&1; done
systemctl enable --now jaryan-acme.timer >/dev/null 2>&1 || true
systemctl enable --now jaryan-files-backup.timer >/dev/null 2>&1 || true
for s in $SVCS; do systemctl restart "$s.service"; done
nginx -t
systemctl reload nginx
echo "== به‌روزرسان /update"
NEWUP="$R/updater/jaryan_updater.py"
UP=/opt/jaryan/updater/jaryan_updater.py
if [ "${JARYAN_ROLLBACK:-0}" != 1 ] && [ -f "$NEWUP" ] && ! cmp -s "$NEWUP" "$UP"; then
  install -m 755 "$NEWUP" "$UP.next"
  if python3 -m py_compile "$UP.next" && python3 "$UP.next" has-key; then
    cp -p "$UP" "$UP.prev"
    mv -f "$UP.next" "$UP"
    # صفحه‌ی /update همین الان مشغول همین نصب است؛ برنامه‌ی تازه‌اش ساعت ۰۳:۲۰ تهران (۲۳:۵۰ UTC)
    # بار می‌شود، نه وسط کار. پشتیبان شبانه از همین امشب با نسخه‌ی تازه است.
    WHEN=$(date -u -d "today 23:50" +%s)
    [ "$WHEN" -gt "$(date -u +%s)" ] || WHEN=$(date -u -d "tomorrow 23:50" +%s)
    systemd-run --quiet --collect --unit "jaryan-updater-reload-$WHEN" \
      --on-calendar="$(date -u -d "@$WHEN" '+%Y-%m-%d %H:%M:%S') UTC" \
      /bin/systemctl restart jaryan-updater.service >/dev/null 2>&1 || true
    echo "به‌روزرسان تازه نصب شد (بار شدن: $(date -u -d "@$WHEN" '+%Y-%m-%d %H:%M') UTC)"
  else
    rm -f "$UP.next"
    echo "به‌روزرسان تازه آزمون را نگذراند؛ همان قبلی ماند"
  fi
fi

echo "== منتظر سرویس‌ها"
for _ in $(seq 1 40); do
  if curl -fsS -o /dev/null http://127.0.0.1:3001/ready 2>/dev/null \
     && curl -fsS -o /dev/null http://127.0.0.1:8092/storage/v1/health 2>/dev/null \
     && curl -fsS -o /dev/null http://127.0.0.1:8093/functions/v1/health 2>/dev/null \
     && curl -fsS -o /dev/null http://127.0.0.1:8094/health 2>/dev/null; then
    echo "همه‌ی سرویس‌ها آماده‌اند"; exit 0
  fi
  sleep 1
done
echo "سرویسی بالا نیامد:"
for s in $SVCS; do echo "--- $s: $(systemctl is-active $s)"; journalctl -u "$s" -n 15 --no-pager || true; done
exit 1
