#!/bin/bash
# بعد از جابه‌جایی نسخه (و در برگشت خودکار برای نسخه‌ی قبلی): سرویس‌ها و nginx.
set -euo pipefail
R="$JARYAN_RELEASE"
if [ "${JARYAN_ROLLBACK:-0}" = 1 ]; then
  # پایگاه داده از پشتیبان برگشته؛ لایه‌ی سازگاری و رمزها دوباره هماهنگ شوند
  python3 "$R/services/migrate.py" apply "$R"
fi
chmod 711 /etc/jaryan          # PostgREST (کاربر jaryan) فقط postgrest.conf را بخواند؛ بقیه 600 هستند
install -m 644 "$R"/systemd/*.service /etc/systemd/system/
systemctl daemon-reload
systemctl enable jaryan-api.service jaryan-net.service jaryan-setup.service >/dev/null 2>&1
systemctl restart jaryan-api.service jaryan-net.service jaryan-setup.service
nginx -t
systemctl reload nginx
echo "== منتظر رابط برنامه"
for _ in $(seq 1 30); do
  curl -fsS -o /dev/null http://127.0.0.1:3001/ready && { echo "رابط برنامه آماده است"; exit 0; }
  sleep 1
done
echo "رابط برنامه بالا نیامد:"
journalctl -u jaryan-api.service -n 30 --no-pager || true
exit 1
