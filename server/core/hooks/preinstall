#!/bin/bash
# پیش از جابه‌جایی نسخه: بررسی پیش‌نیازها و به‌روز کردن پایگاه داده.
# اگر چیزی رد شود، به‌روزرسان نصب را متوقف و پایگاه داده را از پشتیبانِ همین لحظه برمی‌گرداند.
set -euo pipefail
R="$JARYAN_RELEASE"
echo "== بررسی پیش‌نیازها"
command -v psql >/dev/null || { echo "Postgres نصب نیست (نصب پایه کامل نشده)"; exit 1; }
systemctl is-active --quiet postgresql || systemctl start postgresql
V=$(runuser -u postgres -- psql -tAc "show server_version_num")
[ "$V" -ge 140000 ] || { echo "نسخه‌ی Postgres قدیمی است: $V"; exit 1; }
python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' || { echo "پایتون ۳٫۱۰ یا تازه‌تر لازم است"; exit 1; }
FREE=$(df -Pm /var/lib/postgresql | awk 'NR==2{print $4}')
[ "$FREE" -ge 1024 ] || { echo "فضای خالی دیسک کمتر از ۱ گیگابایت است ($FREE مگابایت)"; exit 1; }
"$R/bin/postgrest" --version
id jaryan >/dev/null 2>&1 || useradd --system --home-dir /opt/jaryan --shell /usr/sbin/nologin jaryan
runuser -u postgres -- psql -tAc "select 1 from pg_database where datname='jaryan'" | grep -q 1 \
  || runuser -u postgres -- createdb jaryan
echo "== پایگاه داده"
python3 "$R/services/migrate.py" apply "$R"
