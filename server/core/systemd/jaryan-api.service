[Unit]
Description=Jaryan API (PostgREST)
After=network.target postgresql.service
Wants=postgresql.service
ConditionPathExists=/opt/jaryan/current/bin/postgrest

[Service]
User=jaryan
Group=jaryan
ExecStart=/opt/jaryan/current/bin/postgrest /etc/jaryan/postgrest.conf
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
