[Unit]
Description=Jaryan outgoing requests (pg_net replacement: SMS)
After=network.target postgresql.service
Wants=postgresql.service
ConditionPathExists=/opt/jaryan/current/services/net_worker.py

[Service]
User=postgres
Group=postgres
Environment=JARYAN_PSQL=psql
RuntimeDirectory=jaryan-net
ExecStart=/usr/bin/python3 /opt/jaryan/current/services/net_worker.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
