    "test:dist": "SITE_DIR=dist/design playwright test",
    "test:report": "playwright show-report",
    "demo:codes": "node demo/tools/codes.mjs",
    "demo:data": "node demo/data/generate.mjs",
    "demo:media": "node demo/tools/media.mjs",
    "demo:build": "node demo/data/generate.mjs && vite build --config demo/vite.demo.config.js && node demo/tools/pack.mjs",
    "demo:serve": "node demo/tools/serve.mjs",
    "demo:fetch": "node demo/tools/fetch-snapshot.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
